public class ParkingLot {

    // Number of parked vehicles
    private int twoWheelers;
    private int fourWheelers;

    // Maximum parking capacity
    private final int twoCap;
    private final int fourCap;

    // Total parking revenue
    private static long revenue = 0;

    // Constructor
    public ParkingLot(int twoCap, int fourCap) {
        this.twoCap = twoCap;
        this.fourCap = fourCap;

        this.twoWheelers = 0;
        this.fourWheelers = 0;
    }

    // Park a vehicle
    public void park(String type) {

        if (type.equalsIgnoreCase("two")) {

            if (twoWheelers < twoCap) {
                twoWheelers++;
                revenue += 20;

                System.out.println(
                    "Two-wheeler parked successfully."
                );
            } else {
                System.out.println(
                    "Full - Two-wheeler parking is full."
                );
            }

        } else if (type.equalsIgnoreCase("four")) {

            if (fourWheelers < fourCap) {
                fourWheelers++;
                revenue += 40;

                System.out.println(
                    "Four-wheeler parked successfully."
                );
            } else {
                System.out.println(
                    "Full - Four-wheeler parking is full."
                );
            }

        } else {
            System.out.println("Invalid vehicle type!");
        }
    }

    // Remove a vehicle
    public void leave(String type) {

        if (type.equalsIgnoreCase("two")) {

            if (twoWheelers > 0) {
                twoWheelers--;
                System.out.println(
                    "Two-wheeler left the parking."
                );
            } else {
                System.out.println(
                    "No two-wheelers to remove."
                );
            }

        } else if (type.equalsIgnoreCase("four")) {

            if (fourWheelers > 0) {
                fourWheelers--;
                System.out.println(
                    "Four-wheeler left the parking."
                );
            } else {
                System.out.println(
                    "No four-wheelers to remove."
                );
            }

        } else {
            System.out.println("Invalid vehicle type!");
        }
    }

    // Main method
    public static void main(String[] args) {

        // Capacity: 2 two-wheelers, 1 four-wheeler
        ParkingLot lot = new ParkingLot(2, 1);

        System.out.println("===== PARKING LOT SYSTEM =====");

        // Park two-wheelers
        lot.park("two");
        lot.park("two");

        // Try to park when full
        lot.park("two");

        // Park a four-wheeler
        lot.park("four");

        // Try to park another four-wheeler
        lot.park("four");

        // One vehicle leaves
        lot.leave("two");

        // Park again in the empty space
        lot.park("two");

        // Final details
        System.out.println("\n===== FINAL DETAILS =====");
        System.out.println(
            "Two-wheelers parked: " + lot.twoWheelers
        );
        System.out.println(
            "Four-wheelers parked: " + lot.fourWheelers
        );
        System.out.println(
            "Total revenue: Rs. " + revenue
        );
    }
}
