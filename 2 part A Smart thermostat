public class Thermostat {

    // Private data members
    private String location;
    private int temperature;

    // Fixed minimum and maximum temperature
    private static final int MIN = 16;
    private static final int MAX = 30;

    // Count of created thermostats
    private static int activeCount = 0;

    // Constructor with location and temperature
    public Thermostat(String location, int startTemp) {
        this.location = location;

        if (startTemp >= MIN && startTemp <= MAX) {
            this.temperature = startTemp;
        } else {
            this.temperature = 22;
        }

        activeCount++;
    }

    // Constructor with location only
    public Thermostat(String location) {
        this(location, 22);
    }

    // Increase temperature
    public void raise() {
        if (temperature < MAX) {
            temperature++;
        } else {
            System.out.println("Already at maximum (30)");
        }
    }

    // Decrease temperature
    public void lower() {
        if (temperature > MIN) {
            temperature--;
        } else {
            System.out.println("Already at minimum (16)");
        }
    }

    // Getter method
    public int getTemperature() {
        return temperature;
    }

    // Static method to get object count
    public static int getActiveCount() {
        return activeCount;
    }

    // Main method
    public static void main(String[] args) {

        // Create two thermostat objects
        Thermostat t1 = new Thermostat("Living Room", 25);
        Thermostat t2 = new Thermostat("Bedroom");

        System.out.println("Smart Thermostat System");
        System.out.println("-----------------------");

        // Raise temperature 10 times
        System.out.println("\nRaising temperature:");

        for (int i = 1; i <= 10; i++) {
            t1.raise();
            System.out.println("Temperature: " + t1.getTemperature());
        }

        // Lower temperature 20 times
        System.out.println("\nLowering temperature:");

        for (int i = 1; i <= 20; i++) {
            t1.lower();
            System.out.println("Temperature: " + t1.getTemperature());
        }

        // Print number of created objects
        System.out.println("\nActive thermostat count: "
                + Thermostat.getActiveCount());
    }
}
